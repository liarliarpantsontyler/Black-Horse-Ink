# SMS — use mock for Google Voice handoff / local dev
SMS_PROVIDER=mock
# SMS_PROVIDER=quo
QUO_API_KEY=
QUO_PHONE_NUMBER_ID=

# Staff alerts on new quote submissions
LEAD_NOTIFY_PHONE=+19402524142
